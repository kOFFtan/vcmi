diff --git a/client/NetPacksClient.cpp b/client/NetPacksClient.cpp
index 3d1e39c..1659a5e 100644
--- a/client/NetPacksClient.cpp
+++ b/client/NetPacksClient.cpp
@@ -995,6 +995,8 @@ void ApplyClientNetPackVisitor::visitPlayerStartsTurn(PlayerStartsTurn & pack)
 	// During AutoHeroes we synthesize PlayerStartsTurn locally in order to start
 	// Nullkiller2 for the *current* human turn. Do not restore the human interface
 	// here: doing so would replace the AI before AIGateway::yourTurn() is dispatched.
+	if(AutoHeroes::isPhaseActive() && AutoHeroes::phasePlayer() == pack.player)
+		logGlobal->info("AutoHeroes v0.5: PlayerStartsTurn dispatched to Nullkiller2 without restoring human interface");
 	callAllInterfaces(cl, &IGameEventsReceiver::playerStartsTurn, pack.player);
 	callOnlyThatInterface(cl, pack.player, &CGameInterface::yourTurn, pack.queryID);
 }
@@ -1009,7 +1011,10 @@ void ApplyClientNetPackVisitor::visitPlayerEndsTurn(PlayerEndsTurn & pack)
 	// haveTurn flag and its endTurn() loop can finish. Only then restore the human
 	// interface for the next real turn.
 	if(AutoHeroes::isPhaseActive() && AutoHeroes::phasePlayer() == pack.player)
+	{
+		logGlobal->info("AutoHeroes v0.5: PlayerEndsTurn received; restoring human interface after AI finished");
 		cl.finishAutoHeroesPhase(pack.player);
+	}
 
 	if(!settings["session"]["aiSolo"].Bool() || !GAME->interface() || GAME->interface()->playerID != pack.player)
 		return;
